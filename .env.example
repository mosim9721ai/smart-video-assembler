# Fal.ai API key — get one at https://fal.ai/dashboard/keys
# Format: KEY_ID:KEY_SECRET
FAL_KEY=your_fal_key_here

# --- Image generation ---
# fal-ai/flux/schnell   (fastest, cheap)
# fal-ai/flux/dev       (better quality, slower)
# fal-ai/flux-pro/v1.1  (best)
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# --- TTS (used by /api/script-to-video) ---
# "auto" detects Devanagari vs Latin script and picks:
#   Hindi   → fal-ai/kokoro/hindi           voice hf_alpha
#   English → fal-ai/kokoro/american-english voice am_michael
# Override with any Fal TTS model / voice id.
FAL_TTS_MODEL=auto
FAL_TTS_VOICE=auto

# --- LLM (used to turn script chunks into image prompts) ---
FAL_LLM_MODEL=fal-ai/any-llm
FAL_LLM_SUBMODEL=google/gemini-flash-1.5
