# Fal.ai API key — get one at https://fal.ai/dashboard/keys
# Format: KEY_ID:KEY_SECRET
FAL_KEY=your_fal_key_here

# Model preset for image generation. Options:
#   fal-ai/flux/schnell   (fastest, cheap, good quality)
#   fal-ai/flux/dev       (slower, better quality)
#   fal-ai/flux-pro/v1.1  (best quality)
FAL_IMAGE_MODEL=fal-ai/flux/schnell
